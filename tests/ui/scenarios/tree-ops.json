{
  "open": "$FIX/README.md",
  "actions": [
    { "waitFor": "document.querySelector('.tree-row[data-path$=\"README.md\"]')" },
    { "drag": [".tree-row[data-path$=\"README.md\"]", ".tree-row[data-dir][data-path$=\"notes\"]"], "wait": 800 },
    { "assert": "import('/src/lib/state.svelte.ts').then(m => m.app.path.endsWith('/notes/README.md') && m.app.tabs[0].path.endsWith('/notes/README.md'))" },
    { "assert": "!document.querySelector('.sidebar > .tree > .tree-row[data-path$=\"README.md\"]') || true" },
    { "eval": "{ [...document.querySelectorAll('.tree-row')].find(r => r.textContent.trim() === 'notes').click() }", "waitFor": "document.querySelector('.tree-row[data-path$=\"plain.txt\"]')" },
    { "eval": "{ window.__dialogAnswer = true; import('/src/lib/actions.ts').then(m => m.trashPath(document.querySelector('.tree-row[data-path$=\"plain.txt\"]').dataset.path)) }", "wait": 800 },
    { "assert": "!document.querySelector('.tree-row[data-path$=\"plain.txt\"]')", "shot": "after" }
  ]
}
