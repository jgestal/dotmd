{
 "open": "$FIX/README.md",
 "settings": {
  "wordGoal": 100,
  "zenFullscreen": false,
  "theme": "modern"
 },
 "actions": [
  {
   "waitFor": "document.querySelector('.preview a[href=\"notes/second.md\"]')",
   "wait": 300
  },
  {
   "eval": "{ document.querySelector('.preview a[href=\"notes/second.md\"]').dispatchEvent(new MouseEvent('mouseover', { bubbles: true })) }",
   "waitFor": "document.querySelector('.peek')?.textContent.includes('Second note')",
   "shot": "peek"
  },
  {
   "eval": "{ document.querySelector('.preview a[href=\"notes/second.md\"]').dispatchEvent(new MouseEvent('mouseout', { bubbles: true, relatedTarget: document.body })) }",
   "wait": 200
  },
  {
   "assert": "!document.querySelector('.peek')"
  },
  {
   "chord": [
    "Mod",
    "Digit2"
   ],
   "waitFor": "document.querySelector('.cm-content')",
   "wait": 300
  },
  {
   "eval": "{ const line = [...document.querySelectorAll('.cm-line')].find(l => l.textContent.includes('another note')); const w = document.createTreeWalker(line, NodeFilter.SHOW_TEXT); let n; while ((n = w.nextNode()) && !n.textContent.includes('another')); const r = document.createRange(); const i = n.textContent.indexOf('another'); r.setStart(n, i + 2); r.setEnd(n, i + 3); const b = r.getBoundingClientRect(); document.querySelector('.cm-content').dispatchEvent(new MouseEvent('mousedown', { bubbles: true, cancelable: true, clientX: b.left + 1, clientY: b.top + b.height / 2, metaKey: true, ctrlKey: !navigator.platform.includes('Mac'), button: 0 })); }",
   "waitFor": "document.querySelector('.topbar .name')?.textContent === 'second.md'"
  },
  {
   "chord": [
    "Mod",
    "KeyW"
   ],
   "waitFor": "document.querySelector('.topbar .name')?.textContent === 'README.md'"
  },
  {
   "chord": [
    "Mod",
    "Shift",
    "KeyT"
   ],
   "waitFor": "document.querySelector('.topbar .name')?.textContent === 'second.md'"
  },
  {
   "eval": "{ import('/src/lib/actions.ts').then(m => m.openPath(window.__FIX + '/long.md')) }",
   "waitFor": "document.querySelector('.topbar .name')?.textContent === 'long.md'",
   "wait": 300
  },
  {
   "chord": [
    "Mod",
    "Digit1"
   ],
   "waitFor": "document.querySelectorAll('.preview h2').length > 2",
   "wait": 400
  },
  {
   "eval": "{ document.querySelector('.preview-scroll').scrollTop = 1500; document.querySelector('.preview-scroll').dispatchEvent(new Event('scroll')); }",
   "wait": 300
  },
  {
   "eval": "{ import('/src/lib/actions.ts').then(m => m.openPath(window.__FIX + '/README.md')) }",
   "waitFor": "document.querySelector('.topbar .name')?.textContent === 'README.md'",
   "wait": 600
  },
  {
   "eval": "{ import('/src/lib/actions.ts').then(m => m.openPath(window.__FIX + '/long.md')) }",
   "waitFor": "document.querySelector('.topbar .name')?.textContent === 'long.md'",
   "wait": 900
  },
  {
   "assert": "Math.abs(document.querySelector('.preview-scroll').scrollTop - 1500) < 40 || document.querySelector('.preview-scroll').scrollTop"
  },
  {
   "chord": [
    "Mod",
    "Digit2"
   ],
   "waitFor": "document.querySelector('.cm-content')",
   "wait": 300
  },
  {
   "eval": "{ document.querySelector('.cm-content').focus(); import('/src/lib/commands.ts').then(m => m.runCommand(m.allCommands().find(c => c.id === 'fmt.dateLong'))) }",
   "wait": 400
  },
  {
   "eval": "{ import('/src/lib/state.svelte.ts').then(m => (window.__content = m.app.content)) }",
   "waitFor": "window.__content"
  },
  {
   "assert": "window.__content.includes(String(new Date().getFullYear())) && /[A-Z][a-z]+ \\d{1,2}, \\d{4}/.test(window.__content)"
  },
  {
   "eval": "{ document.querySelector('.files-bar [data-sort]').click() }",
   "wait": 300
  },
  {
   "assert": "document.querySelector('.files-bar [data-sort]').dataset.sort === 'modified'"
  },
  {
   "eval": "{ import('/src/lib/container.ts').then(m => m.files.duplicate(window.__FIX + '/table.md')) }",
   "waitFor": "[...document.querySelectorAll('.tree-row')].some(r => r.textContent.includes('table copy.md'))"
  },
  {
   "chord": [
    "Mod",
    "Shift",
    "Enter"
   ],
   "wait": 300
  },
  {
   "eval": "{ window.dispatchEvent(new MouseEvent('mousemove', { clientX: 300, clientY: 20 })) }",
   "wait": 300,
   "shot": "zen-goal"
  },
  {
   "assert": "/ 100 words/.test(document.querySelector('.zen-words').textContent) && !!document.querySelector('.zen-goal i')"
  },
  {
   "keys": "Escape",
   "wait": 200
  }
 ]
}