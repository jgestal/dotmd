{
 "open": "$FIX/README.md",
 "settings": {
  "theme": "modern"
 },
 "actions": [
  {
   "waitFor": "document.querySelector('.markdown-body h1')"
  },
  {
   "eval": "{ window.__S = import('/src/lib/state.svelte.ts') }",
   "wait": 200
  },
  {
   "eval": "{ window.__S.then(m => { m.settings.theme = 'notebook'; }) }",
   "wait": 700,
   "shot": "notebook"
  },
  {
   "assert": "document.querySelector('.content').classList.contains('theme-notebook') && document.querySelector('.content').dataset.theme === 'notebook'"
  },
  {
   "eval": "{ window.__S.then(m => { m.settings.theme = 'manuscript'; }) }",
   "wait": 700,
   "shot": "manuscript"
  },
  {
   "assert": "document.querySelector('.content').classList.contains('theme-book') && document.querySelector('.content').dataset.theme === 'manuscript'"
  },
  {
   "eval": "{ window.__S.then(m => { m.settings.theme = 'sepia-night'; }) }",
   "wait": 700,
   "shot": "sepia-night"
  },
  {
   "assert": "document.querySelector('.content').classList.contains('theme-book') && document.querySelector('.content').dataset.theme === 'sepia-night'"
  },
  {
   "eval": "{ window.__S.then(m => { m.settings.theme = 'eink'; }) }",
   "wait": 700,
   "shot": "eink"
  },
  {
   "assert": "document.querySelector('.content').classList.contains('theme-eink') && document.querySelector('.content').dataset.theme === 'eink'"
  },
  {
   "eval": "{ window.__S.then(m => { m.settings.theme = 'accessible'; }) }",
   "wait": 700,
   "shot": "accessible"
  },
  {
   "assert": "document.querySelector('.content').classList.contains('theme-accessible') && document.querySelector('.content').dataset.theme === 'accessible'"
  },
  {
   "eval": "{ window.__S.then(m => { m.settings.theme = 'chalkboard'; }) }",
   "wait": 700,
   "shot": "chalkboard"
  },
  {
   "assert": "document.querySelector('.content').classList.contains('theme-chalk') && document.querySelector('.content').dataset.theme === 'chalkboard'"
  },
  {
   "eval": "{ window.__S.then(m => { m.settings.theme = 'gameboy'; }) }",
   "wait": 700,
   "shot": "gameboy"
  },
  {
   "assert": "document.querySelector('.content').classList.contains('theme-gameboy') && document.querySelector('.content').dataset.theme === 'gameboy'"
  },
  {
   "eval": "{ window.__S.then(m => { m.settings.theme = 'teletype'; }) }",
   "wait": 700,
   "shot": "teletype"
  },
  {
   "assert": "document.querySelector('.content').classList.contains('theme-teletype') && document.querySelector('.content').dataset.theme === 'teletype'"
  },
  {
   "eval": "{ window.__S.then(m => { m.settings.theme = 'parchment'; }) }",
   "wait": 700,
   "shot": "parchment"
  },
  {
   "assert": "document.querySelector('.content').classList.contains('theme-parchment') && document.querySelector('.content').dataset.theme === 'parchment'"
  },
  {
   "eval": "{ window.__S.then(m => { m.settings.theme = 'notebook'; }) }",
   "wait": 300
  },
  {
   "chord": [
    "Mod",
    "Digit2"
   ],
   "waitFor": "document.querySelector('.cm-content')",
   "wait": 600,
   "shot": "notebook-source"
  }
 ]
}