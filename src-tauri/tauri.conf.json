{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "DotMD",
  "version": "0.1.0",
  "identifier": "com.jgestal.dotmd",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../build"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "DotMD — Markdown Viewer & Editor",
        "width": 1200,
        "height": 800,
        "minWidth": 520,
        "minHeight": 360,
        "visible": false,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true,
        "dragDropEnabled": true
      }
    ],
    "security": {
      "csp": null,
      "assetProtocol": {
        "enable": true,
        "scope": [
          "**"
        ]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "Productivity",
    "shortDescription": "Markdown viewer & editor",
    "fileAssociations": [
      {
        "ext": [
          "md",
          "markdown",
          "mdown",
          "mkd"
        ],
        "name": "Markdown document",
        "role": "Editor",
        "mimeType": "text/markdown"
      }
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "longDescription": "DotMD is a fast, native-feeling Markdown and text viewer and editor with live preview, page view, themes, zen writing mode and HTML/PDF export.",
    "copyright": "© 2026 Juan Gestal. MIT License."
  }
}
