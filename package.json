{
  "name": "dotmd",
  "version": "0.2.0",
  "description": "",
  "type": "module",
  "scripts": {
    "dev": "vite dev",
    "build": "vite build",
    "preview": "vite preview",
    "prepare": "svelte-kit sync || echo ''",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
    "tauri": "tauri",
    "test:ui": "node tests/ui/run.mjs",
    "test:rust": "cd src-tauri && cargo test",
    "screenshots": "node tests/ui/run.mjs screenshots && for n in welcome read split pages tractor typewriter csv focus-crt settings; do cp tests/ui/out/screenshots-$n.png docs/screenshots/$n.png; done",
    "test": "vitest run",
    "build:debug": "tauri build --debug --no-bundle",
    "test:cli": "node tests/e2e/cli.mjs",
    "test:coverage": "vitest run --coverage"
  },
  "license": "MIT",
